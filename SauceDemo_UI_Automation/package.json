{
  "name": "saucedemo-playwright-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript end-to-end UI automation for SauceDemo",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report evidence/report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
