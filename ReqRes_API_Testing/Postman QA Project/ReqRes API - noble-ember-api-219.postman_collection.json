    {
      "name": "Collection Records",
      "item": [
        {
          "name": "List records",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\n\npm.test(\"data is an array\", () => {\n  const json = pm.response.json();\n  pm.expect(json.data).to.be.an(\"array\");\n});\n\npm.test(\"meta has page and total\", () => {\n  const json = pm.response.json();\n  pm.expect(json).to.have.property(\"meta\");\n  pm.expect(json.meta).to.have.property(\"page\");\n  pm.expect(json.meta).to.have.property(\"total\");\n});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{manageKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/collections/products/records?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "collections",
                "products",
                "records"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create record",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate fresh random product data for every run",
                  "const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];",
                  "const rand = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;",
                  "",
                  "const adjectives = [\"Wireless\", \"Ergonomic\", \"Compact\", \"Rugged\", \"Premium\", \"Smart\", \"Portable\", \"Vintage\", \"Eco\", \"Ultra\"];",
                  "const nouns = [\"Mouse\", \"Keyboard\", \"Headset\", \"Webcam\", \"Speaker\", \"Charger\", \"Monitor\", \"Dock\", \"Lamp\", \"Backpack\"];",
                  "const categories = [\"accessories\", \"audio\", \"office\", \"gaming\", \"home\", \"travel\", \"power\"];",
                  "",
                  "pm.variables.set(\"productName\", pick(adjectives) + \" \" + pick(nouns));",
                  "pm.variables.set(\"productPrice\", (rand(499, 49999) / 100).toFixed(2));",
                  "pm.variables.set(\"productInStock\", String(Math.random() < 0.5));",
                  "pm.variables.set(\"productCategory\", pick(categories));",
                  ""
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));\n\npm.test(\"Response has data\", () => {\n  const json = pm.response.json();\n  pm.expect(json).to.have.property(\"data\");\n});\n\nif (pm.response.code === 201) {\n  const json = pm.response.json();\n  pm.environment.set(\"recordId\", json.data.id);\n}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{manageKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"name\": \"{{productName}}\",\n    \"price\": {{productPrice}},\n    \"in_stock\": {{productInStock}},\n    \"category\": \"{{productCategory}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/products/records",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "collections",
                "products",
                "records"
              ]
            },
            "description": "No schema is defined for products, so the body is a sample. Saves data.id to recordId."
          },
          "response": []
        },
